# Personal Buzz relay variable inventory.
#
# This file contains placeholders only. Do not copy it into source control with
# real values. Configure staging and personal production separately in the
# provider secret store. Never reuse a private key, database, bucket, Redis
# instance, or webhook secret between environments.

# Public relay identity and routing.
RELAY_URL=wss://CHANGE_ME_RELAY_HOST
RELAY_OWNER_PUBKEY=CHANGE_ME_64_CHARACTER_LOWERCASE_HEX_PUBLIC_KEY
BUZZ_BIND_ADDR=0.0.0.0:3000
BUZZ_HEALTH_PORT=8080
BUZZ_METRICS_PORT=9102
BUZZ_MEDIA_BASE_URL=https://CHANGE_ME_RELAY_HOST/media
BUZZ_CORS_ORIGINS=https://CHANGE_ME_RELAY_HOST

# Stable secrets. Generate independently per environment and store only in the
# provider secret store and the approved encrypted recovery system.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_SECRET
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_SECRET

# Provider-private data services. Use provider reference variables rather than
# pasting connection strings into shell history or deployment logs.
DATABASE_URL=CHANGE_ME_PROVIDER_PRIVATE_DATABASE_URL
REDIS_URL=CHANGE_ME_PROVIDER_PRIVATE_REDIS_URL

# Private S3-compatible object storage. New Railway buckets use virtual-hosted
# addressing. Older buckets can require path addressing, so prove the selected
# style in staging before production.
BUZZ_S3_ENDPOINT=https://storage.railway.app
BUZZ_S3_ADDRESSING_STYLE=virtual
BUZZ_S3_ACCESS_KEY=CHANGE_ME_SECRET
BUZZ_S3_SECRET_KEY=CHANGE_ME_SECRET
BUZZ_S3_BUCKET=CHANGE_ME_PROVIDER_BUCKET_NAME
BUZZ_S3_REGION=auto

# Persistent Git working data. Railway must attach exactly one volume at this
# path. The runtime entrypoint changes ownership only on this directory and then
# drops to UID/GID 1000. Do not scale beyond one replica with this volume.
BUZZ_GIT_REPO_PATH=/data/git

# Closed-relay production controls.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_REQUIRE_MEDIA_GET_AUTH=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_GIT_CONFORMANCE_PROBE=true

# Required in both personal staging and personal production. On startup the
# relay repairs missing, legacy, wrong-signer, or stale kind:39000 discovery
# metadata with its durable relay key before multi-user acceptance. The sweep
# remains bound to the community resolved from RELAY_URL.
BUZZ_RECONCILE_CHANNELS=true

# Migrations run through the Railway pre-deploy command. Keeping startup
# auto-migration off makes a failed migration stop promotion before the new
# relay process starts.
BUZZ_AUTO_MIGRATE=false

# Tune only from observed staging load and record every override.
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Intentionally omitted:
# - READ_DATABASE_URL until a read replica and freshness behavior are proven.
# - RAILWAY_VOLUME_MOUNT_PATH. Railway injects it only when the volume is
#   attached. Never set it manually because the entrypoint uses it as a mount
#   presence guard.
# - RAILWAY_RUN_UID. The runtime-personal image entrypoint starts as root only
#   long enough to validate and fix /data/git, then drops to UID/GID 1000.
# - Any Agency Brain URL or webhook secret. Those belong in Agency Brain's
#   environment-specific secret store, never in the relay service.
